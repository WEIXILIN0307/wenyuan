# Optional configuration; no credentials are included. Set variables in the shell before scripts/dev.sh.
WENYUAN_BACKEND=http://127.0.0.1:8001
WENYUAN_PORT=8001
WENYUAN_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
WENYUAN_MODEL_ORIGINS=https://api.openai.com
# Set to 1 behind HTTPS; default localhost HTTP development uses 0.
WENYUAN_SECURE_COOKIE=0
